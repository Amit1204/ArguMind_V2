# ------------------------------------------------------------------
# ArguMind - environment template
#
# Copy this file to `.env` and adjust values as needed:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# Every variable has a safe local default, so `docker compose up --build`
# works before you edit anything (with LLM_PROVIDER=mock, no key needed).
# ------------------------------------------------------------------

# --- Application -----------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json: one structured object per line with request_id (default). text: plain lines.
LOG_FORMAT=json

# --- Host ports -----------------------------------------------------
# Chosen so this stack can run next to the AI Business Analyst Copilot
# (which uses 3000 / 8000 / 5432).
FRONTEND_PORT=3100
BACKEND_PORT=8100
# PostgreSQL is bound to 127.0.0.1 only; it is never exposed beyond the host.
POSTGRES_PORT=5433

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=argumind
POSTGRES_USER=argumind
POSTGRES_PASSWORD=argumind_dev_password
# URL the backend uses inside the Docker network.
DATABASE_URL=postgresql+psycopg://argumind:argumind_dev_password@postgres:5432/argumind

# --- LLM provider -----------------------------------------------------
# gemini : Google Gemini via the free AI Studio tier (https://aistudio.google.com)
# mock   : deterministic canned responses; no key needed (tests, CI)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Model tiers: fast = classification and extraction, standard = synthesis.
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_STANDARD=gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Gemini 3 thinking depth for the standard tier (low | medium | high). Thinking
# tokens count against the output cap, so "low" keeps JSON answers complete.
LLM_THINKING_LEVEL=low
# Local guard so a runaway loop cannot exhaust the provider's daily quota.
LLM_DAILY_REQUEST_LIMIT=1000
# Optional USD-per-million-token prices for cost tracking, e.g.
# {"gemini-3-flash-preview": {"input": 0.30, "output": 2.50}}. Empty = $0 (free tier).
LLM_PRICE_TABLE_JSON=

# --- Sources (arXiv and Wikipedia, no keys) ------------------------------------
SOURCE_TIMEOUT_SECONDS=15
SOURCE_RETRY_ATTEMPTS=3
# Identical searches are served from the source_cache table for this long.
SOURCE_CACHE_TTL_HOURS=24
ARXIV_MAX_RESULTS=5
# arXiv's terms of use: at most one request every 3 seconds; bursts get 429s,
# and recently throttled clients are answered slowly for a while.
ARXIV_MIN_INTERVAL_SECONDS=3
ARXIV_TIMEOUT_SECONDS=30
WIKIPEDIA_MAX_RESULTS=3

# --- Pipeline ------------------------------------------------------------
# Whole-run time budget in seconds; stages stop gracefully once exceeded.
RUN_TIMEOUT_SECONDS=180
